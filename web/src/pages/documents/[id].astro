---
import Base from "../../layouts/Base.astro";
import RefBadge from "../../components/RefBadge.astro";
import catalog from "../../../public/exports/catalog.json";

export function getStaticPaths() {
  return catalog.compositions.map((composition: any) => ({
    params: { id: composition.id },
    props: { composition },
  }));
}

const { composition } = Astro.props;
const refs = composition.references ?? {};

type Ref = { ref: string; version: string };
const sections: Array<{ label: string; values: Ref[] }> = [
  { label: "Tutorials", values: refs.tutorials ?? [] },
  { label: "Explanations", values: refs.explanations ?? [] },
  { label: "Runbooks", values: refs.runbooks ?? [] },
  { label: "How-tos", values: refs.how_tos ?? [] },
  { label: "Reference guides", values: refs.reference_guides ?? [] },
];
---
<Base title={composition.name} description={composition.summary}>
  <p><a href="/documents/">← All documents</a></p>
  <h1>{composition.name}</h1>
  <p style="color: var(--muted);">
    <code>document</code> · <code>v{composition.version}</code>
  </p>

  {composition.summary && <p>{composition.summary}</p>}

  <h2>References</h2>
  {sections.map(section => section.values.length > 0 && (
    <div style="margin-bottom: 1.5rem;">
      <h3 style="margin-bottom: 0.5rem;">{section.label}</h3>
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
        {section.values.map((r: Ref) => <RefBadge ref={r.ref} version={r.version} />)}
      </div>
    </div>
  ))}

  <h2>Raw composition</h2>
  <p><a href={`/documents/${composition.id}.json`}>/documents/{composition.id}.json</a> · <a href="/schemas/composition-v1.json">schema</a></p>
</Base>
