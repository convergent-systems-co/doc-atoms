---
import Base from "../layouts/Base.astro";
import catalog from "../../public/exports/catalog.json";
const counts = {
  atoms: catalog.atoms.length,
  compositions: catalog.compositions.length,
};
const byType: Record<string, number> = {};
for (const a of catalog.atoms) byType[a.type] = (byType[a.type] ?? 0) + 1;
---
<Base title="Home" description="Explanatory documentation as atoms — tutorials, explanations, runbooks, how-tos, reference guides.">
  <h1>doc-atoms</h1>
  <p style="font-size: 1.125rem; color: var(--muted); max-width: 40rem;">
    Explanatory documentation as atoms — tutorials, explanations,
    runbooks, how-tos, and reference guides. The narrative/teaching
    catalog of the <code>convergent-systems.co</code> ecosystem.
  </p>

  <p>
    doc-atoms is <strong>not</strong> <a href="https://github.com/convergent-systems-co/schema-atoms">schema-atoms</a>.
    schema-atoms is normative (specs and JSON Schemas). doc-atoms is
    explanatory (narrates, teaches, illustrates). If it tells you how
    to do something, it lives here. If it tells you what conformance
    requires, it lives there.
  </p>

  <h2>Catalog at v{catalog.version}</h2>
  <ul>
    <li><strong>{counts.atoms}</strong> atoms across {Object.keys(byType).length} types</li>
    <li><strong>{counts.compositions}</strong> document compositions</li>
  </ul>

  <h2>Atom types</h2>
  <ul>
    <li><code>tutorial</code> — guided learning, opinionated path from zero</li>
    <li><code>explanation</code> — clarifying narrative, the "why" behind a concept</li>
    <li><code>runbook</code> — operational procedure, ordered steps for a known scenario</li>
    <li><code>how-to</code> — focused task answer, problem-shaped</li>
    <li><code>reference-guide</code> — lookup-shaped, organized for non-linear reading</li>
  </ul>

  <h2>Civilization-grade properties</h2>
  <ul>
    <li><strong>Typed</strong> — every atom and composition validates against a JSON Schema.</li>
    <li><strong>Versioned</strong> — every atom has a semver <code>version</code> field; compositions pin by version.</li>
    <li><strong>Machine-readable</strong> — <a href="/exports/catalog.json">/exports/catalog.json</a> is the canonical manifest.</li>
    <li><strong>Composable</strong> — compositions reference atoms by ID; references resolve in CI.</li>
    <li><strong>Open</strong> — Apache-2.0 (code) + CC-BY-4.0 (data).</li>
    <li><strong>Signed</strong> — atoms-spec/v1.1.0 ML-DSA-65 signatures, post-quantum from inception.</li>
  </ul>
</Base>
